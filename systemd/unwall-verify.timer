[Unit]
Description=Unwall - öğrenilen alan adlarını düzenli olarak doğrula
Documentation=https://github.com/WinTone01/Unwall

[Timer]
# Açılıştan 15 dk sonra, sonra saatte bir. Persistent: makine kapalıyken
# kaçırılan çalıştırma açılışta telafi edilir.
OnBootSec=15min
OnUnitActiveSec=1h
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
