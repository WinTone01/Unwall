[Unit]
Description=Zapret Linux Türkiye - DPI atlatma motoru
Documentation=https://github.com/bol-van/zapret
After=network.target nss-lookup.target
Wants=network.target
ConditionPathExists=@ETCDIR@/zapret-turkey.conf

[Service]
Type=exec
ExecStartPre=@BINDIR@/zapret-turkeyctl nft-apply
ExecStart=@BINDIR@/zapret-turkeyctl run-engine
ExecStopPost=@BINDIR@/zapret-turkeyctl nft-flush
Restart=on-failure
RestartSec=3
KillMode=mixed

# nfqws NFQUEUE'ya bağlanmak ve ham paket üretmek için ağ yetkileri ister.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_MODULE CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@ETCDIR@ @LOGDIR@
PrivateTmp=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
