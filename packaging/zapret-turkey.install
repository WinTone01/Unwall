post_install() {
	cat <<'EOF'

Zapret Türkiye kuruldu. Motorlar henüz derlenmedi:

    sudo zapret-turkeyctl build

Ardından "Zapret Türkiye" uygulamasını başlatabilir ya da:

    sudo zapret-turkeyctl doctor
    sudo zapret-turkeyctl start

EOF
}

post_upgrade() {
	systemctl daemon-reload 2>/dev/null || true
	echo "Motorları güncellemek için: sudo zapret-turkeyctl build"
}

pre_remove() {
	systemctl disable --now zapret-turkey.service 2>/dev/null || true
	zapret-turkeyctl nft-flush 2>/dev/null || true
	zapret-turkeyctl dns disable 2>/dev/null || true
}

post_remove() {
	echo "Ayarlar /etc/zapret-turkey ve motorlar /opt/zapret-turkey altında kaldı."
}
