# Maintainer: WinTone01 <wintone01@users.noreply.github.com>
pkgname=unwall
pkgver=1.3.14
pkgrel=1
pkgdesc="GTK4 control panel for the zapret/nfqws DPI bypass engine"
arch=('any')
url="https://github.com/WinTone01/Unwall"
license=('GPL3')
depends=('nftables' 'python-gobject' 'libadwaita' 'gtk4' 'polkit' 'systemd' 'bind')
makedepends=('git')
optdepends=(
	'libcap: required to build the engines'
	'luajit: to build the zapret2 (LUA) engine'
	'libnetfilter_queue: to build the engines'
	'libnfnetlink: to build the engines'
	'libmnl: to build the engines'
	'dnscrypt-proxy: encrypted DNS (DoH)'
)
backup=(
	'etc/unwall/unwall.conf'
	'etc/unwall/hostlist.txt'
	'etc/unwall/excludelist.txt'
)
install=unwall.install
source=()

package() {
	cd "$startdir/.."

	install -Dm755 bin/unwallctl "$pkgdir/usr/bin/unwallctl"
	sed -i \
		-e 's|^UW_LIB=.*|UW_LIB="${UW_LIB:-/usr/lib/unwall}"|' \
		-e 's|^UW_ETC=.*|UW_ETC="${UW_ETC:-/etc/unwall}"|' \
		-e 's|^UW_OPT=.*|UW_OPT="${UW_OPT:-/opt/unwall}"|' \
		-e 's|^UW_LOG=.*|UW_LOG="${UW_LOG:-/var/log/unwall}"|' \
		"$pkgdir/usr/bin/unwallctl"

	install -Dm755 bin/unwall "$pkgdir/usr/bin/unwall"
	sed -i 's|^UW_LIB=.*|UW_LIB="${UW_LIB:-/usr/lib/unwall}"|' \
		"$pkgdir/usr/bin/unwall"

	install -Dm644 gui/unwall_gui.py "$pkgdir/usr/lib/unwall/unwall_gui.py"
	install -Dm644 lib/strategies.conf "$pkgdir/usr/lib/unwall/strategies.conf"

	install -Dm644 etc/unwall.conf "$pkgdir/etc/unwall/unwall.conf"
	install -Dm644 hostlist.txt "$pkgdir/etc/unwall/hostlist.txt"
	install -Dm644 excludelist.txt "$pkgdir/etc/unwall/excludelist.txt"
	install -Dm644 autohostlist.txt "$pkgdir/etc/unwall/autohostlist.txt"

	sed -e 's|@BINDIR@|/usr/bin|g' -e 's|@ETCDIR@|/etc/unwall|g' \
		-e 's|@LOGDIR@|/var/log/unwall|g' systemd/unwall.service \
		> "$srcdir/unwall.service"
	install -Dm644 "$srcdir/unwall.service" \
		"$pkgdir/usr/lib/systemd/system/unwall.service"

	sed 's|@BINDIR@|/usr/bin|g' polkit/io.github.WinTone01.Unwall.policy \
		> "$srcdir/io.github.WinTone01.Unwall.policy"
	install -Dm644 "$srcdir/io.github.WinTone01.Unwall.policy" \
		"$pkgdir/usr/share/polkit-1/actions/io.github.WinTone01.Unwall.policy"

	install -Dm644 share/io.github.WinTone01.Unwall.desktop \
		"$pkgdir/usr/share/applications/io.github.WinTone01.Unwall.desktop"
	install -Dm644 share/io.github.WinTone01.Unwall.svg \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.WinTone01.Unwall.svg"
	install -Dm644 share/io.github.WinTone01.Unwall.metainfo.xml \
		"$pkgdir/usr/share/metainfo/io.github.WinTone01.Unwall.metainfo.xml"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 README.tr.md "$pkgdir/usr/share/doc/$pkgname/README.tr.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

	echo 'nfnetlink_queue' > "$srcdir/modules.conf"
	install -Dm644 "$srcdir/modules.conf" "$pkgdir/usr/lib/modules-load.d/unwall.conf"
}
