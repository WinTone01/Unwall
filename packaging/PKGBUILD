# Maintainer: Zapret Linux Türkiye
pkgname=zapret-turkey
pkgver=1.0.0
pkgrel=1
pkgdesc="Türkiye için zapret/zapret2 DPI atlatma kontrol paneli (GTK4)"
arch=('any')
url="https://github.com/wintone01/zapret-linux-turkey"
license=('MIT')
depends=('nftables' 'python-gobject' 'libadwaita' 'gtk4' 'polkit' 'systemd' 'bind')
makedepends=('git')
optdepends=(
	'luajit: zapret2 (LUA) motorunu derlemek için'
	'libnetfilter_queue: motorları derlemek için'
	'libnfnetlink: motorları derlemek için'
	'libmnl: motorları derlemek için'
	'dnscrypt-proxy: şifreli DNS (YogaDNS karşılığı)'
)
backup=(
	'etc/zapret-turkey/zapret-turkey.conf'
	'etc/zapret-turkey/hostlist.txt'
	'etc/zapret-turkey/excludelist.txt'
)
install=zapret-turkey.install
source=()

package() {
	cd "$startdir/.."

	install -Dm755 bin/zapret-turkeyctl "$pkgdir/usr/bin/zapret-turkeyctl"
	sed -i \
		-e 's|^ZT_LIB=.*|ZT_LIB="${ZT_LIB:-/usr/lib/zapret-turkey}"|' \
		-e 's|^ZT_ETC=.*|ZT_ETC="${ZT_ETC:-/etc/zapret-turkey}"|' \
		-e 's|^ZT_OPT=.*|ZT_OPT="${ZT_OPT:-/opt/zapret-turkey}"|' \
		-e 's|^ZT_LOG=.*|ZT_LOG="${ZT_LOG:-/var/log/zapret-turkey}"|' \
		"$pkgdir/usr/bin/zapret-turkeyctl"

	install -Dm755 bin/zapret-turkey "$pkgdir/usr/bin/zapret-turkey"
	sed -i 's|^ZT_LIB=.*|ZT_LIB="${ZT_LIB:-/usr/lib/zapret-turkey}"|' \
		"$pkgdir/usr/bin/zapret-turkey"

	install -Dm644 gui/zapret_turkey_gui.py "$pkgdir/usr/lib/zapret-turkey/zapret_turkey_gui.py"
	install -Dm644 lib/strategies.conf "$pkgdir/usr/lib/zapret-turkey/strategies.conf"

	install -Dm644 etc/zapret-turkey.conf "$pkgdir/etc/zapret-turkey/zapret-turkey.conf"
	install -Dm644 hostlist.txt "$pkgdir/etc/zapret-turkey/hostlist.txt"
	install -Dm644 excludelist.txt "$pkgdir/etc/zapret-turkey/excludelist.txt"
	install -Dm644 autohostlist.txt "$pkgdir/etc/zapret-turkey/autohostlist.txt"

	sed -e 's|@BINDIR@|/usr/bin|g' -e 's|@ETCDIR@|/etc/zapret-turkey|g' \
		-e 's|@LOGDIR@|/var/log/zapret-turkey|g' systemd/zapret-turkey.service \
		> "$srcdir/zapret-turkey.service"
	install -Dm644 "$srcdir/zapret-turkey.service" \
		"$pkgdir/usr/lib/systemd/system/zapret-turkey.service"

	sed 's|@BINDIR@|/usr/bin|g' polkit/org.zapret.turkey.policy \
		> "$srcdir/org.zapret.turkey.policy"
	install -Dm644 "$srcdir/org.zapret.turkey.policy" \
		"$pkgdir/usr/share/polkit-1/actions/org.zapret.turkey.policy"

	install -Dm644 share/zapret-turkey.desktop \
		"$pkgdir/usr/share/applications/zapret-turkey.desktop"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

	echo 'nfnetlink_queue' > "$srcdir/modules.conf"
	install -Dm644 "$srcdir/modules.conf" "$pkgdir/usr/lib/modules-load.d/zapret-turkey.conf"
}
